PORT=3000
NODE_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_jwt_secret_salt_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="ICMLDE 2026 Secretariat" <secretariat@icmlde2026.org>

# Official registration form (Indian authors pay via its Paytm link)
OFFICIAL_REGISTRATION_URL=https://icmlde.org/icmlde_registration5.html
# Public site URL used in emails
SITE_URL=https://icmlde-website.vercel.app

# Fee receipts (fee-receipt.html) — paste your Google Sheet link.
# Share the sheet as "Anyone with the link: Viewer", or use File > Share > Publish to web > CSV.
FEE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit#gid=0
# For local testing you can point at a CSV file instead:
# FEE_SHEET_FILE=docs/fee-sheet-template.csv
# FEE_SHEET_CACHE_SECONDS=60

# Submissions closed 30 Aug 2026, registration closed 15 Nov 2026. Set to true to reopen (also remove data-closed in the page).
SUBMISSIONS_OPEN=false
REGISTRATION_OPEN=false
